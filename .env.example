# Copy this file to .env for local development.
# Do not commit real secrets.

# ---------------------------------------------------------------------------
# Local development
# ---------------------------------------------------------------------------
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# ---------------------------------------------------------------------------
# Authentication database
# ---------------------------------------------------------------------------
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_MONGODB_URI=mongodb://user:password@host:27017/?authSource=admin
AUTH_DB_NAME=studioSpaceDB

# ---------------------------------------------------------------------------
# Google login
#
# Add this authorized redirect URI in Google Cloud Console:
#   http://localhost:3000/api/auth/callback/google
#   https://studioclient.vercel.app/api/auth/callback/google
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Optional comma-separated list of extra origins allowed to call Better Auth.
# AUTH_TRUSTED_ORIGINS=https://studioclient.vercel.app
